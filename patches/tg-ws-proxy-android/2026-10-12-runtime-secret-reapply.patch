+    private fun extractStat(stats: String, key: String): String {
+        val idx = stats.indexOf(key)
+        if (idx == -1) return "0B"
+        val start = idx + key.length
+        val end = stats.indexOf(" ", start)
+        return if (end == -1) stats.substring(start) else stats.substring(start, end)
+    }
